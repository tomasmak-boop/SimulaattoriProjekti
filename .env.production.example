# Production environment for the CIP Simulation Platform.
# Copy to /etc/cip-sim/env on the target server and edit the marked lines.
# The systemd units read this file via EnvironmentFile=.

# --- Django ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE-ME-GENERATE-A-REAL-SECRET
DJANGO_DEBUG=0
# Comma-separated hostnames/IPs the server is reachable on.
# CHANGE: put the server's intranet IP first.
DJANGO_ALLOWED_HOSTS=10.0.0.5,localhost,127.0.0.1
DJANGO_HSTS=0

# --- Data stores ----------------------------------------------------------
# sqlite is fine for a single-server intranet deployment.
DATABASE_URL=sqlite:////var/lib/cip-sim/db.sqlite3
REDIS_URL=redis://localhost:6379/0

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO

# --- Networking -----------------------------------------------------------
# CHANGE: the address CODESYS/SCADA clients will use, in host:port form.
GATEWAY_PUBLIC_HOST=10.0.0.5:8080
GATEWAY_OPCUA_PORT=8080

# --- Worker pool ----------------------------------------------------------
OPCUA_PORT_START=5000
OPCUA_PORT_END=5100
HTTP_PORT_OFFSET=1000

# --- Timeouts (seconds) ---------------------------------------------------
WORKER_IDLE_TIMEOUT=1800
WORKER_STOP_GRACE=10
HEARTBEAT_INTERVAL=10
HEARTBEAT_TTL=30